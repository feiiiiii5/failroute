# Build the arXiv submission for the failroute study.
#
#   make            full build: Tectonic when available, otherwise TeX Live
#   make quick      one compiler pass for fast layout feedback
#   make submission build then bundle main.tar.gz for arXiv upload
#   make clean      remove build products
#
# Tectonic is preferred because it builds the bibliography in one command. If it
# is unavailable, the Makefile falls back to the TeX Live pdflatex/BibTeX cycle.

MAIN    := main
FIGURE_SOURCE := ../figures
FIGURE_PDFS := $(wildcard $(FIGURE_SOURCE)/*.pdf)
TEX_ENGINE ?= auto
TECTONIC_AVAILABLE := $(shell command -v tectonic >/dev/null 2>&1 && echo yes)
ifeq ($(TEX_ENGINE),auto)
  ifeq ($(TECTONIC_AVAILABLE),yes)
    TEX_ENGINE := tectonic
  else
    TEX_ENGINE := pdflatex
  endif
endif

ifeq ($(TEX_ENGINE),tectonic)
  LATEX ?= tectonic
  LATEXFLAGS ?= -X compile --keep-logs --keep-intermediates
else
  LATEX ?= pdflatex
  BIBTEX ?= bibtex
  LATEXFLAGS ?= -interaction=nonstopmode -halt-on-error -file-line-error
endif

.PHONY: all quick submission clean sync-figures

all: $(MAIN).pdf

# Keep the arXiv source bundle in sync with the canonical figures generated by
# tools/make_figures.py. The old local copies can otherwise silently survive a
# figure rename and produce a stale or incomplete submission.
sync-figures:
	@test -n "$(FIGURE_PDFS)" || (echo "no generated figure PDFs in $(FIGURE_SOURCE)"; exit 1)
	@mkdir -p figures
	@find figures -maxdepth 1 -type f -name '*.pdf' -delete
	cp $(FIGURE_PDFS) figures/

ifeq ($(TEX_ENGINE),tectonic)
$(MAIN).pdf: $(MAIN).tex refs.bib $(FIGURE_PDFS) | sync-figures
	$(LATEX) $(LATEXFLAGS) $(MAIN).tex
else
$(MAIN).pdf: $(MAIN).tex refs.bib $(FIGURE_PDFS) | sync-figures
	$(LATEX) $(LATEXFLAGS) $(MAIN).tex
	-$(BIBTEX) $(MAIN)
	$(LATEX) $(LATEXFLAGS) $(MAIN).tex
	$(LATEX) $(LATEXFLAGS) $(MAIN).tex
endif

quick: $(MAIN).tex
	$(LATEX) $(LATEXFLAGS) $(MAIN).tex

# Bundle only what arXiv needs; refuses to run if the build has errors.
# COPYFILE_DISABLE=1 is required, not cosmetic: without it macOS tar stores an
# AppleDouble "._x" member beside every file. They stay invisible here, because
# bsdtar folds them back into extended attributes on extraction -- but arXiv
# runs GNU tar on Linux, which materialises all six as real files, and
# "._main.tex" is a binary blob rather than TeX. Verified 2026-09-09: a bundle
# built without this variable carried six such members.
submission: all
	@test -s $(MAIN).pdf || (echo "no PDF produced"; exit 1)
	@if /usr/bin/grep -q '^!' $(MAIN).log; then \
	  echo "LaTeX errors present in $(MAIN).log -- refusing to bundle"; exit 1; \
	fi
	COPYFILE_DISABLE=1 tar -czf $(MAIN).tar.gz \
	  $(MAIN).tex refs.bib figures/*.pdf $(MAIN).bbl
	@strays=$$(python3 -c "import tarfile; \
	  print(sum(1 for n in tarfile.open('$(MAIN).tar.gz').getnames() \
	  if n.rsplit('/',1)[-1].startswith('._')))"); \
	 if [ "$$strays" != "0" ]; then \
	   echo "$(MAIN).tar.gz carries $$strays AppleDouble member(s) -- refusing"; \
	   rm -f $(MAIN).tar.gz; exit 1; \
	 fi
	@echo "wrote $(MAIN).tar.gz"

clean:
	rm -f $(MAIN).pdf $(MAIN).aux $(MAIN).log $(MAIN).out $(MAIN).bbl $(MAIN).blg \
	      $(MAIN).tar.gz
